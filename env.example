# Profile selector: 'main' or 'dev' (defaults to 'dev')
BOT_PROFILE=dev

# Discord Bot Configuration (profiled)
DISCORD_TOKEN_MAIN=
CLIENT_ID_MAIN=
DISCORD_TOKEN_DEV=
CLIENT_ID_DEV=
OWNER_ID=

# Database Configuration (Supabase)
SUPABASE_URL_MAIN=
SUPABASE_SERVICE_ROLE_MAIN=
SUPABASE_URL_DEV=
SUPABASE_SERVICE_ROLE_DEV=

# Optional: Logging Configuration
LOG_LEVEL=VERBOSE
LOG_TO_FILE=false
LOG_FILE_PATH=logs/trustfactor-bot.log
MAX_LOG_FILE_SIZE=10485760
