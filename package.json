{
  "name": "trustfactor-discord-bot",
  "version": "1.0.0",
  "description": "A community-driven Discord bot for tracking user scores through voting",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:restart": "node restart.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "migrate": "node src/migrations/migrate.js",
    "deploy-commands": "node src/utils/deploy-commands.js",
    "security:apply": "node src/migrations/apply_rls.js",
    "security:verify": "node src/migrations/verify_rls.js",
    "security:fix": "npm run security:apply && npm run security:verify",
    "security:functions": "node src/migrations/apply_function_security.js",
    "security:functions-verify": "node src/migrations/verify_function_security.js",
    "security:schema-verify": "node src/migrations/verify_schema_security.js",
    "security:full": "npm run security:apply && npm run security:functions && npm run security:verify && npm run security:functions-verify",
    "performance:apply": "node src/migrations/apply_performance_optimization.js",
    "performance:verify": "node src/migrations/verify_performance_optimization.js",
    "performance:schema-verify": "node src/migrations/verify_schema_performance.js",
    "performance:optimize": "npm run performance:apply && npm run performance:verify",
    "database:verify-all": "npm run security:schema-verify && npm run performance:schema-verify"
  },
  "keywords": [
    "discord",
    "bot",
    "scoring",
    "community",
    "voting"
  ],
  "author": "TrustFactor Bot Team",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.1",
    "@supabase/supabase-js": "^2.39.7",
    "dotenv": "^16.4.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
